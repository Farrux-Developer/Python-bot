# ==============================================================
# WebOrder Bot - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================

# Telegram Bot Token obtained from @BotFather (Required)
# Format: 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram Payments Provider Token from @BotFather (Optional)
# Leave blank or omit if online payments via Invoices are not used yet
PROVIDER_TOKEN=284685063:TEST:NzA3_...

# Telegram User ID of the primary Administrator (Required for admin panel)
# Integer user ID (get it from @userinfobot or @raw_data_bot)
# Example: 123456789
ADMIN_ID=123456789

# Developer profile and contact links (Optional)
GITHUB_URL=https://github.com/Farrux-Developer
DEVELOPER_TG=https://t.me/farrux_igamberdiev
DEVELOPER_USERNAME=@farrux_igamberdiev

# SQLite Database filename (Optional, default: weborder_bot.db)
DB_PATH=weborder_bot.db

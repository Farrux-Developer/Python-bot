[Unit]
Description=WebOrder Telegram Bot Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/Python-bot
ExecStart=/opt/Python-bot/venv/bin/python main.py
Restart=always
RestartSec=10
EnvironmentFile=/opt/Python-bot/.env

# Security sandboxing
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
